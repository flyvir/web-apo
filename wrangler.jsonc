{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apo",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b24e5e89-deed-4337-9697-703949e438da","database_name": "web-apo" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "59877cd05ecc4981930ca9832c7b5c4f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
